PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase: create a project at https://supabase.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenAI: keep this key on the server only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Razorpay subscriptions (optional until you enable paid plans)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# Set to true only after configuring and testing the Razorpay webhook.
PAYMENTS_ENABLED=false